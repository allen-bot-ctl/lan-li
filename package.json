{
  "name": "lan-li",
  "version": "0.1.60",
  "private": true,
  "description": "栏历：macOS 菜单栏公历与农历月历。",
  "homepage": "https://allen-bot-ctl.github.io/lan-li/",
  "main": "electron/main.js",
  "productName": "栏历",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "e2e": "playwright test",
    "dist": "electron-builder --mac"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "defuddle": "0.19.13",
    "lunar-javascript": "1.7.8",
    "turndown": "7.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "app.lanli.LanLi",
    "productName": "栏历",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.utilities",
      "artifactName": "LanLi-${version}-mac-${arch}.${ext}",
      "icon": "electron/assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "afterSign": "scripts/stable-sign.js"
  }
}
