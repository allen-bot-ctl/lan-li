{
  "name": "lan-li",
  "version": "0.1.73",
  "private": true,
  "description": "栏历：macOS 菜单栏公历与农历月历。",
  "homepage": "https://allen-bot-ctl.github.io/lan-li/",
  "main": "electron/main.js",
  "productName": "栏历",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "e2e": "playwright test",
    "dist": "electron-builder --mac",
    "build:inbox-editor": "esbuild electron/renderer/inbox-writer-entry.js --bundle --minify --format=iife --outfile=electron/renderer/vendor/inbox-writer.js",
    "prestart": "npm run build:inbox-editor",
    "pree2e": "npm run build:inbox-editor",
    "predist": "npm run build:inbox-editor"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "defuddle": "0.19.13",
    "linkedom": "0.18.12",
    "lunar-javascript": "1.7.8",
    "markdown-it": "15.0.3",
    "turndown": "7.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^31.7.7",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "app.lanli.LanLi",
    "productName": "栏历",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "category": "public.app-category.utilities",
      "artifactName": "LanLi-${version}-mac-${arch}.${ext}",
      "icon": "electron/assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "afterSign": "scripts/stable-sign.js"
  }
}
